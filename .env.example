# Sarvam configuration. Copy to .env (never commit .env). Placeholders only.
# SSOT NFR-07: at most 3 variables are REQUIRED for a LIVE run
# (SARVAM_LLM_API_KEY, SARVAM_SEARCH_API_KEY, and the LLM provider name). Everything else has a default.

# --- General ---
SARVAM_ENV=development
SARVAM_MODE=live                      # live | replay (REPLAY works fully offline)

# --- API ---
SARVAM_API_HOST=127.0.0.1
SARVAM_API_PORT=8000
SARVAM_CORS_ORIGINS=http://localhost:5173

# --- Frontend (read by Vite at build/dev time) ---
VITE_API_BASE_URL=http://localhost:8000

# --- Storage ---
SARVAM_DB_PATH=data/sarvam.db
SARVAM_ARTIFACT_DIR=data/artifacts
SARVAM_RECORD_DIR=cache/recorded

# --- Search provider (one primary, one optional fallback) ---
SARVAM_SEARCH_PROVIDER=your-search-provider
SARVAM_SEARCH_API_KEY=replace-me
SARVAM_SEARCH_FALLBACK_PROVIDER=
SARVAM_SEARCH_FALLBACK_API_KEY=

# --- LLM provider (FAST and STRONG tiers) ---
# SARVAM_LLM_PROVIDER is openai | openrouter | groq, or the full base URL of any OpenAI-compatible
# endpoint. Gemini: https://generativelanguage.googleapis.com/v1beta/openai (keep
# SARVAM_LLM_CONCURRENCY low, for example 2, on free-tier request limits).
SARVAM_LLM_PROVIDER=your-llm-provider
SARVAM_LLM_API_KEY=replace-me
SARVAM_LLM_MODEL_FAST=replace-with-fast-model
SARVAM_LLM_MODEL_STRONG=replace-with-strong-model

# --- Run budgets (SSOT 5.1 defaults) ---
SARVAM_MAX_SEARCHES=24
SARVAM_MAX_FETCHES=40
SARVAM_MAX_LLM_CALLS=250
SARVAM_MAX_COST_USD=3.00
SARVAM_MAX_WALL_SECONDS_SOFT=480
SARVAM_MAX_WALL_SECONDS_HARD=600
SARVAM_MAX_FOLLOWUP_ROUNDS=2
SARVAM_FETCH_CONCURRENCY=8
SARVAM_LLM_CONCURRENCY=8

# --- LLM optimisation / accounting (optional; see docs/LLM_OPTIMIZATION_REPORT.md) ---
# SARVAM_LLM_COMPACT_JSON=1            # compact JSON payloads (default 1)
# SARVAM_PASSAGES_PER_SLOT=5           # extractor context passages (default 5)
# SARVAM_VERIFIER_BATCH_SIZE=5         # claim/passage pairs per verifier call
# SARVAM_EXTRACTOR_BATCH_SIZE=1        # slots per extractor call for one source (1 = legacy; >1 = batched, experimental)
# SARVAM_EXTRACTOR_MIN_OVERLAP=0       # B-35: slot words a source's OTHER slots need in their best passage (0 = off, 3 = candidate)
# SARVAM_LLM_MAX_TOKENS=writer=6000    # per-role output ceiling overrides (role=int,...)
# SARVAM_LLM_PRICE_FAST=0.10,0.40      # USD per 1M tokens (input,output); unset = cost unavailable
# SARVAM_LLM_PRICE_STRONG=0.30,2.50
# SARVAM_RECORD=1                      # record provider responses for replay (LIVE runs)
