# Sarvam frontend configuration. Copy to .env.local. Only VITE_-prefixed variables reach the browser.
# Base URL of the FastAPI backend (the /api prefix is added by the client).
VITE_API_BASE_URL=http://127.0.0.1:8000
# 1 = run entirely on scripted in-browser mock data (no backend needed; shows a MOCK DATA banner).
VITE_USE_MOCK=0
