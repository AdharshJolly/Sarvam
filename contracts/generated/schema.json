        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "status": {
          "$ref": "#/$defs/SourceStatus",
          "default": "found"
        },
        "fail_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fail Reason"
        },
        "origin_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Id"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "id",
        "run_id",
        "url",
        "canonical_url",
        "domain"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourceStatus": {
      "description": "Source status: found/fetched plus the typed fetch failures from section 18.",
      "enum": [
        "found",
        "fetched",
        "SOURCE_UNAVAILABLE",
        "SOURCE_EMPTY"
      ],
      "title": "SourceStatus",
      "type": "string"
    },
    "SourceType": {
      "enum": [
        "regulator",
        "company_primary",
        "news",
        "blog",
        "unknown"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "StopDecision": {
      "additionalProperties": false,
      "description": "Deterministic stop outcome (SSOT 9.10, Appendix B).",
      "properties": {
        "state": {
          "$ref": "#/$defs/FinalState"
        },
        "termination_reason": {
          "$ref": "#/$defs/TerminationReason"
        },
        "critical_slots": {
          "$ref": "#/$defs/CriticalSlotCounts"
        },
        "open_conflicts": {
          "default": 0,
          "title": "Open Conflicts",
          "type": "integer"
        },
        "challenge_rounds_completed": {
          "default": 0,
          "title": "Challenge Rounds Completed",
          "type": "integer"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        }
      },
      "required": [
        "state",
        "termination_reason"
      ],
      "title": "StopDecision",
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "slot_id": {
          "title": "Slot Id",
          "type": "string"
        },
        "query_text": {
          "title": "Query Text",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TaskKind",
          "default": "initial"
        },
        "round": {
          "default": 0,
          "title": "Round",
          "type": "integer"
        },
        "status": {
          "default": "pending",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "run_id",
        "slot_id",
        "query_text"
      ],
      "title": "Task",
      "type": "object"
    },
    "TaskKind": {
      "enum": [
        "initial",
        "gap",
        "challenge"
      ],
      "title": "TaskKind",
      "type": "string"
    },
    "TerminationReason": {
      "enum": [
        "criteria_met",
        "no_marginal_gain",
        "max_rounds",
        "budget",
        "timeout",
        "user_stopped",
        "blocked"
      ],
      "title": "TerminationReason",
      "type": "string"
    },
    "Verdict": {
      "enum": [
        "supports",
        "partial",
        "contradicts",
        "irrelevant"
      ],
      "title": "Verdict",
      "type": "string"
    }
  }
