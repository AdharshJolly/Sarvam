package-lock.json
yarn.lock
pnpm-lock.yaml

# ---- Environment / secrets ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Databases (local runtime state) ----
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
/data/*
!/data/.gitkeep
/artifacts/

# ---- Runtime ----
logs/
*.log
temp/
tmp/
cache/

# ---- IDE ----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Claude / local agent artifacts ----
.claude/settings.local.json
.claude/worktrees/

# ---- Graphify (generated index; regenerate with `make graph`) ----
graphify-out/
